{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dromocob Universal Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "targets",
    "sharedAssets",
    "variants",
    "rollback"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "after-effects",
          "premiere",
          "final-cut",
          "resolve"
        ]
      }
    },
    "sharedAssets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "variants": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "after-effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asset"
          },
          "minItems": 1
        },
        "premiere": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asset"
          },
          "minItems": 1
        },
        "final-cut": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asset"
          },
          "minItems": 1
        },
        "resolve": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asset"
          },
          "minItems": 1
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "previousVersion",
        "previousManifestSHA256"
      ],
      "properties": {
        "previousVersion": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "previousManifestSHA256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "sha256",
        "bytes"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,180}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    }
  }
}
